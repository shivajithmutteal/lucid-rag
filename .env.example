# ─────────────────────────────────────────────────────────────────────────────
# lucid-rag configuration. Copy to `.env` and edit.
# Local-first: with only DATABASE_URL set, lucid-rag runs entirely on local models
# (Ollama for generation, a local model for embeddings + reranking) — no API key,
# and your data never leaves your machine. Set any provider key below to override.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Postgres + pgvector) ──
DATABASE_URL=postgres://lucid:lucid@localhost:5432/lucid

# ── Generation (answers) ── first match wins: OpenAI → Groq → Gemini → OpenRouter → local Ollama
# (One OpenAI-compatible adapter drives all of these. Anthropic's /v1/messages is a
#  separate adapter, added in a later sub-phase.)
# OPENAI_API_KEY=sk-...
# OPENAI_GEN_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1        # override for any OpenAI-compatible gateway
# GROQ_API_KEY=gsk_...
# GROQ_GEN_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=...
# GEMINI_GEN_MODEL=gemini-2.0-flash
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_GEN_MODEL=meta-llama/llama-3.3-70b-instruct
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_GEN_MODEL=llama3.2

# ── Embeddings ── Voyage → OpenAI → local
# VOYAGE_API_KEY=pa-...
# VOYAGE_EMBED_MODEL=voyage-3.5-lite
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OLLAMA_EMBED_MODEL=nomic-embed-text
# EMBED_DIMS=1024                                  # only needed for a model whose dims aren't built-in

# ── Reranking (Phase 1.3) ── Cohere → Voyage → local cross-encoder
# COHERE_API_KEY=...
# VOYAGE_API_KEY=...            # shared with embeddings

# ── Pipeline toggles ──
# CONTEXTUAL_RETRIEVAL=true     # LLM-generated situating context per chunk at ingest
# RERANK=true                   # cross-encoder rerank of candidates
